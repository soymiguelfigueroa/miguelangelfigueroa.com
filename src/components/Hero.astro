---
import { portfolioData } from '../data/portfolio';
const { personal } = portfolioData;
---

<section id="sobre-mi" class="pt-32 pb-20 md:pt-40 md:pb-28 overflow-hidden relative">
  <!-- Subtle background glow -->
  <div class="absolute top-1/4 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[500px] h-[350px] bg-indigo-500/10 dark:bg-indigo-600/15 rounded-full blur-3xl pointer-events-none"></div>

  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 relative">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
      <!-- Left Column: Copy & CTAs -->
      <div class="lg:col-span-7 space-y-6">
        <!-- Availability Badge -->
        {personal.availableForHire && (
          <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-emerald-50 dark:bg-emerald-950/60 border border-emerald-200 dark:border-emerald-800 text-xs font-semibold text-emerald-700 dark:text-emerald-300 shadow-xs">
            <span class="relative flex h-2 w-2">
              <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
              <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
            </span>
            <span>{personal.availabilityStatus}</span>
          </div>
        )}

        <!-- Headline -->
        <div class="space-y-2">
          <p class="text-sm md:text-base font-semibold text-indigo-600 dark:text-indigo-400 uppercase tracking-wider font-mono">
            {personal.role}
          </p>
          <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold text-slate-900 dark:text-white tracking-tight leading-[1.1]">
            Hola, soy <span class="text-transparent bg-clip-text bg-gradient-to-r from-indigo-600 via-violet-600 to-indigo-500 dark:from-indigo-400 dark:via-violet-400 dark:to-indigo-300">{personal.name}</span>
          </h1>
        </div>

        <!-- Description -->
        <p class="text-lg sm:text-xl text-slate-600 dark:text-slate-300 leading-relaxed max-w-2xl">
          {personal.tagline}
        </p>
        <p class="text-base text-slate-500 dark:text-slate-400 leading-relaxed max-w-2xl">
          {personal.bio}
        </p>

        <!-- CTAs -->
        <div class="flex flex-wrap items-center gap-4 pt-2">
          <a
            href="#proyectos"
            class="inline-flex items-center justify-center gap-2 px-6 py-3 rounded-xl bg-indigo-600 hover:bg-indigo-700 text-white font-semibold text-sm shadow-md shadow-indigo-500/25 active:scale-95 transition-all"
          >
            <span>Explorar Proyectos</span>
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
            </svg>
          </a>

          <a
            href="#contacto"
            class="inline-flex items-center justify-center gap-2 px-6 py-3 rounded-xl bg-slate-100 hover:bg-slate-200 dark:bg-slate-800 dark:hover:bg-slate-700 text-slate-800 dark:text-slate-200 font-semibold text-sm border border-slate-200 dark:border-slate-700 active:scale-95 transition-all"
          >
            <span>Hablemos</span>
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
          </a>
        </div>

        <!-- Social Quick Links -->
        <div class="flex items-center gap-4 pt-4 border-t border-slate-200 dark:border-slate-800 text-slate-500 dark:text-slate-400 text-sm">
          <span class="font-medium text-xs uppercase tracking-wider text-slate-400 dark:text-slate-500">Conectar:</span>
          <a
            href={personal.github}
            target="_blank"
            rel="noopener noreferrer"
            class="p-2 rounded-lg hover:text-indigo-600 dark:hover:text-indigo-400 hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors"
            aria-label="GitHub"
          >
            <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
              <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z" />
            </svg>
          </a>
          <a
            href={personal.linkedin}
            target="_blank"
            rel="noopener noreferrer"
            class="p-2 rounded-lg hover:text-indigo-600 dark:hover:text-indigo-400 hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors"
            aria-label="LinkedIn"
          >
            <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
              <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z" />
            </svg>
          </a>
          <a
            href={`mailto:${personal.email}`}
            class="p-2 rounded-lg hover:text-indigo-600 dark:hover:text-indigo-400 hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors"
            aria-label="Email"
          >
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
          </a>
        </div>
      </div>

      <!-- Right Column: Interactive Code / Tech Badge Mockup -->
      <div class="lg:col-span-5">
        <div class="rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900/90 shadow-xl overflow-hidden font-mono text-xs backdrop-blur-sm">
          <!-- Terminal Header -->
          <div class="flex items-center justify-between px-4 py-3 bg-slate-100/80 dark:bg-slate-800/80 border-b border-slate-200 dark:border-slate-700/60">
            <div class="flex items-center gap-1.5">
              <span class="w-3 h-3 rounded-full bg-rose-500"></span>
              <span class="w-3 h-3 rounded-full bg-amber-500"></span>
              <span class="w-3 h-3 rounded-full bg-emerald-500"></span>
            </div>
            <span class="text-slate-500 dark:text-slate-400 text-[11px]">developer.ts</span>
            <span class="text-slate-400 dark:text-slate-500 text-[10px]">Astro 5</span>
          </div>

          <!-- Code content -->
          <div class="p-5 space-y-2 text-slate-800 dark:text-slate-200 overflow-x-auto leading-relaxed">
            <div>
              <span class="text-indigo-600 dark:text-indigo-400">const</span>{' '}
              <span class="text-amber-600 dark:text-amber-300">developer</span> = &#123;
            </div>
            <div class="pl-4">
              <span class="text-slate-500 dark:text-slate-400">name:</span>{' '}
              <span class="text-emerald-600 dark:text-emerald-400">'{personal.name}'</span>,
            </div>
            <div class="pl-4">
              <span class="text-slate-500 dark:text-slate-400">role:</span>{' '}
              <span class="text-emerald-600 dark:text-emerald-400">'{personal.role}'</span>,
            </div>
            <div class="pl-4">
              <span class="text-slate-500 dark:text-slate-400">focus:</span> [
              <span class="text-emerald-600 dark:text-emerald-400">'Frontend'</span>,{' '}
              <span class="text-emerald-600 dark:text-emerald-400">'Backend'</span>,{' '}
              <span class="text-emerald-600 dark:text-emerald-400">'Cloud'</span>],
            </div>
            <div class="pl-4">
              <span class="text-slate-500 dark:text-slate-400">available:</span>{' '}
              <span class="text-violet-600 dark:text-violet-400">{personal.availableForHire ? 'true' : 'false'}</span>,
            </div>
            <div class="pl-4">
              <span class="text-slate-500 dark:text-slate-400">passions:</span> [
              <span class="text-emerald-600 dark:text-emerald-400">'Clean Code'</span>,{' '}
              <span class="text-emerald-600 dark:text-emerald-400">'Performance'</span>],
            </div>
            <div>&#125;;</div>
            <div class="pt-2 text-slate-400 dark:text-slate-500 italic">
              // Listo para convertir ideas en software robusto.
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
