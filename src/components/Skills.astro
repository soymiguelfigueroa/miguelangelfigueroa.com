---
import { portfolioData } from '../data/portfolio';
const { skillCategories } = portfolioData;
---

<section id="habilidades" class="py-20 md:py-28 border-t border-slate-200/60 dark:border-slate-800/60 bg-slate-100/40 dark:bg-slate-900/30 relative">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Section Heading -->
    <div class="space-y-3 mb-12 md:mb-16">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-md bg-indigo-50 dark:bg-indigo-950/60 border border-indigo-200 dark:border-indigo-800 text-xs font-semibold text-indigo-700 dark:text-indigo-300">
        Stack Tecnológico
      </div>
      <h2 class="text-3xl sm:text-4xl font-extrabold text-slate-900 dark:text-white tracking-tight">
        Habilidades y Especialidades
      </h2>
      <p class="text-base sm:text-lg text-slate-600 dark:text-slate-400 max-w-2xl">
        Tecnologías y herramientas que empleo activamente para construir productos digitales escalables, accesibles y seguros.
      </p>
    </div>

    <!-- Skills Category Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 lg:gap-8">
      {skillCategories.map((category) => (
        <div class="rounded-2xl border border-slate-200/80 dark:border-slate-800 bg-white dark:bg-slate-900/60 p-6 md:p-8 shadow-xs hover:border-slate-300 dark:hover:border-slate-700 transition-colors">
          <div class="flex items-center justify-between gap-3 mb-3">
            <h3 class="text-xl font-bold text-slate-900 dark:text-white tracking-tight">
              {category.category}
            </h3>
            <span class="text-xs font-mono text-slate-400 dark:text-slate-500">
              {category.skills.length} tecnologías
            </span>
          </div>

          <p class="text-sm text-slate-600 dark:text-slate-400 mb-6 leading-relaxed">
            {category.description}
          </p>

          <!-- Skills Badges -->
          <div class="flex flex-wrap gap-2">
            {category.skills.map((skill) => (
              <span
                class={`inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-medium transition-all ${
                  skill.highlight
                    ? 'bg-indigo-50 dark:bg-indigo-950/80 text-indigo-700 dark:text-indigo-300 border border-indigo-200/80 dark:border-indigo-800 font-semibold shadow-xs'
                    : 'bg-slate-100 dark:bg-slate-800/80 text-slate-700 dark:text-slate-300 border border-slate-200/60 dark:border-slate-750'
                }`}
              >
                {skill.highlight && (
                  <span class="w-1.5 h-1.5 rounded-full bg-indigo-500"></span>
                )}
                {skill.name}
              </span>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
