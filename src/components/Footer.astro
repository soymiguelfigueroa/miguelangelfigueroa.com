---
import { portfolioData } from '../data/portfolio';
const { personal } = portfolioData;
const currentYear = new Date().getFullYear();
---

<footer class="border-t border-slate-200/80 dark:border-slate-800/80 bg-white/50 dark:bg-slate-950/50 py-12 transition-colors">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col md:flex-row items-center justify-between gap-6">
      <!-- Left: Brand & Copyright -->
      <div class="flex flex-col sm:flex-row items-center gap-3 text-center sm:text-left">
        <span class="w-7 h-7 rounded-lg bg-indigo-600 text-white flex items-center justify-center font-mono text-xs font-semibold shadow-xs">
          MF
        </span>
        <span class="text-sm text-slate-500 dark:text-slate-400">
          © {currentYear} {personal.name}. Todos los derechos reservados.
        </span>
      </div>

      <!-- Center / Right: Stack Notice -->
      <div class="flex items-center gap-2 text-xs text-slate-500 dark:text-slate-400">
        <span>Construido con</span>
        <span class="px-2 py-0.5 rounded-md bg-slate-100 dark:bg-slate-800 font-semibold text-slate-700 dark:text-slate-300">
          Astro 5
        </span>
        <span>&</span>
        <span class="px-2 py-0.5 rounded-md bg-slate-100 dark:bg-slate-800 font-semibold text-slate-700 dark:text-slate-300">
          Tailwind CSS
        </span>
      </div>

      <!-- Right: Back to top -->
      <a
        href="#"
        class="inline-flex items-center gap-1.5 text-xs font-semibold text-indigo-600 dark:text-indigo-400 hover:text-indigo-700 dark:hover:text-indigo-300 transition-colors"
      >
        <span>Volver arriba</span>
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M5 10l7-7m0 0l7 7m-7-7v18" />
        </svg>
      </a>
    </div>
  </div>
</footer>
